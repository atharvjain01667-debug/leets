//You're given two words. You need to transform word1 into word2 using the fewest possible operations,
// where each operation is one of:
//Insert a character
//Delete a character
//Replace a character

fun minDistance (word1: String, word2: String): Int {
    val m = word1.length
    val n = word2.length

    // dp[i][j] = min operations to convert first i chars of word1
    // into first j chars of word 2
    val dp = Array(m+1) { IntArray(n+1) }

    // base case: converting word1's first i chars to empty word2
    // need i deletion for converting into other word
    for ( i in 0..m) {
        dp[i][0] = i
    }
    // Base case: converting EMPTY word1 to word2's first j chars
    // needs j insertions
    for (j in 0..n) {
        dp[0][j] = j
    }

    // fill rest of table
    for (i in 1..m) {
        for (j in 1..n) {

            if (word1[i - 1] == word2[j - 1]) {
                // chars match , no operations needed here
                //just carry forward the smaller sub - problem's answer
                dp[i][j] = dp[i-1][j-1]
            } else {
                // If chars differ, we do some OPERATIONS
                // pick 3 options that cost least, then add 1
                dp[i][j] = 1 + minOf(
                    dp[i-1][j],    // delete char of word1
                    dp[i][j-1],    // insert char in word1
                    dp[i-1][j-1]   // replacing char in word1
                )
            }
        }
    }
    return dp[m][n]
}

fun main () {
    val word1 = "Atharv"
    val word2  = "var"
    println(minDistance(word1, word2))
}
