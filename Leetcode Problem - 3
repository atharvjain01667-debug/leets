// LetCode Prob - 3
// Given a string containing digits from 2-9 inclusive
//,return all possible letter combinations that the number could represent. Return the answer in any order.
// A mapping of digits to letters (just like on the telephone buttons) is given below.
// Note that 1 does not map to any letters.
// In Kotlin

fun phoneNumCombinations( digits : String): List<String> {
    val result = mutableListOf<String> ()    // Stores all final combinations

    if (digits.isEmpty())      // Edge case = if user gives nothing,
        return result          // if there are no combinations to generate

    val phoneMap = mapOf (      // Map each other to letters
        '2' to "abc", '3' to "def",'4' to "ghi",'5' to "jkl",'6' to "mno",
        '7' to "pqrs", '8' to "tuv", '9' to "wxyz"
    )

    fun backtrack (index: Int, current: StringBuilder) { // Reached end of digit string means (index = current dig)
        if (index == digits.length) {        // means we pick one letter for each digit

            result.add(current.toString())  // save the completed combinations
            return
        }

        val letters = phoneMap[digits[index]]!!  // it checks the current digit  then find its corrs letters

        for (letters in letters) {
            current.append(letters)   //  step 1 : choose the letter, connects the letter
            backtrack(index + 1, current) // step 2 : goes to next digit
            current.deleteCharAt(current.length  - 1) // step 3 : for UNDO choice
        }
    }
    backtrack (0, StringBuilder())   //start building from
    return result
}

fun main () {
    val digits = "36"
    val result = phoneNumCombinations(digits)
    println(result)
}
