//We have stock prices for different days.
// We can buy and sell as many times as you want,
// but you can only hold one share at a time. Find the maximum total profit you can make.
// Just loop through the prices. 
// Every time the next day's price is higher than today's, add that difference to your total profit.
fun maxProfit(prices: IntArray) : Int {
    var profit = 0

    // start from day1 (index 1), since we compare
    // today's price [i] to Yesterday's price [i - 1]
    for (i in 1 until prices.size) {

        // Check if today's price is HIGHER than yesterday's price
        if (prices[i] > prices[i-1]) {

            // if it is , it will grab profit (buy yesterday, sell today)
            profit += prices[i] - prices[i-1]
        }
        // if prices went down or stayed same, it do nothing (skip)
    }
    return profit
}

fun main () {
    println (maxProfit(intArrayOf(7,1,5,3,6,4)))
    println (maxProfit(intArrayOf(1,2,3,4,5)))
}

